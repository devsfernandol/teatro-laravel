# Configuración de Teatro.
#
# instalar.sh crea .env a partir de este archivo, genera las contraseñas y
# completa la sección de publicación. Normalmente no hace falta editarlo:
# PayPal y el correo se configuran desde el panel (Administración → Configuración).

APP_NAME=Teatro
APP_URL=http://localhost:8080
# Clave de cifrado. No la cambie después de instalar: con ella se cifran las
# sesiones y las credenciales guardadas desde el panel.
APP_KEY=
APP_TIMEZONE=America/Costa_Rica

# Base de datos (no se expone fuera de Docker).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Administrador inicial. Debe cambiar la contraseña en el primer inicio de sesión.
ADMIN_EMAIL=admin@teatro.local
ADMIN_PASSWORD=

# Obras, salas, funciones y ventas de ejemplo (solo en la primera instalación).
DEMO_DATA=true

# Moneda de los precios (una que acepte PayPal: USD, EUR, MXN...).
TEATRO_MONEDA=USD

# --- Opcional: valores iniciales de PayPal y correo ----------------------------
# Lo que se guarde en el panel tiene prioridad sobre estos valores.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@teatro.local

# --- Publicación (instalar.sh completa estos valores) ----------------------------
DOMINIO=
HTTP_PORT=8080
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=
RED_TRAEFIK=
ALIAS_WEB=teatro-web
